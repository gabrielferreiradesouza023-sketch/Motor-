# Simulação obrigatória. F0 usa apenas variáveis exportadas; nunca lê .env.
LIVE_MODE=false
# Opcionais na F0; necessários somente para integrações futuras.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
HOTMART_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# F5: preencher versão somente após V-06.
META_API_VERSION=
# Exportação autenticada do Worker.
TRACKER_SYNC_TOKEN=

# Somente na máquina do humano: caminho do arquivo da chave privada Ed25519 (fora do repo).
# A chave pública correspondente fica em config/settings.yaml (approval_public_key).
APPROVAL_PRIVATE_KEY_FILE=

# Centavos BRL; orçamento declarado não substitui o limite no emissor.
CARD_LIMIT_CENTS=
