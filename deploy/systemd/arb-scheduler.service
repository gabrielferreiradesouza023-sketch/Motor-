[Unit]
Description=arb scheduler (simulation)
[Service]
Type=oneshot
User={{ user }}
WorkingDirectory={{ root }}
Environment=LIVE_MODE=false
EnvironmentFile=-/etc/arb/runtime.env
ExecStart=/usr/bin/env LIVE_MODE=false "{{ root }}/.venv/bin/arb" scheduler once --database "{{ root }}/data/engine.db" --root "{{ root }}" --output "{{ root }}/reports"
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths="{{ root }}/data" "{{ root }}/reports"
